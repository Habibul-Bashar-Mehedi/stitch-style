DB_URL=jdbc:postgresql://localhost:5432/stitchstyle
DB_USERNAME=lemon
DB_PASSWORD=lemon
# Keep this port in sync with frontend/proxy.conf.json and API_PROXY_TARGET.
SERVER_PORT=38133
# Register these redirect URIs in Google Cloud Console for the OAuth client:
#   http://localhost:4200/login/oauth2/code/google
#   http://localhost:4000/login/oauth2/code/google
GOOGLE_CLIENT_ID=dev-client-id
GOOGLE_CLIENT_SECRET=dev-client-secret
BOOTSTRAP_ADMIN_EMAILS=admin@example.com
MEDIA_STORAGE=local
# A relative path resolves against the process working directory. Use an absolute
# path if the backend is launched from more than one directory (Gradle, IDE, ...).
MEDIA_LOCAL_ROOT=./data/media
PAYMENT_CALLBACK_SECRET=dev-callback-secret
PUBLIC_BASE_URL=http://localhost:4000
SESSION_COOKIE_SECURE=false

# Redis / two-replica path
REDIS_HOST=localhost
REDIS_PORT=6379
# payment adapters (sandbox mode is enabled with real credentials)
BKASH_ENABLED=false
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# notifications
SMS_URL=
SMS_API_KEY=
SMS_SENDER=StitchStyle
EMAIL_FROM=no-reply@stitchandstyle.bd
# courier adapters
PATHAO_ENABLED=false
STEADFAST_ENABLED=false
REDX_ENABLED=false
# returns
RETURN_WINDOW_DAYS=7
# test/dev tools
DEV_TOOLS_ENABLED=false
